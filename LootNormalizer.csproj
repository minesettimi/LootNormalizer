<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>

        <Version>1.0.0</Version>
        <RootNamespace>LootNormalizer</RootNamespace>
        <AssemblyName>LootNormalizer</AssemblyName>

        <OutputPath>bin\$(Configuration)\$(SolutionName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration) == Release">
        <DebugSymbols>False</DebugSymbols>
        <DebugType>None</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
        <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
        <PackageReference Include="SPTushonka.Reflection" Version="4.1.5" />
        <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
    </ItemGroup>

    <Target  Name="PostBuild" AfterTargets="PostBuildEvent">
        <ItemGroup>
            <CompileFiles Include="$(TargetDir)*.deps.json;$(TargetDir)*.endpoints.json;$(TargetDir)*.runtime.json" />
        </ItemGroup>
        <Delete Files="@(CompileFiles)" />
        <ItemGroup>
            <CopyFiles Include="$(TargetDir)/**/*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(CopyFiles)" DestinationFolder="$(SolutionDir)../../SPT_Runtime/user/mods/$(SolutionName)\%(RecursiveDir)" />
    </Target>

    <Target Name="PostBuildCopy" AfterTargets="PostBuild" Condition="$(Configuration) == Release">
        <Copy SourceFiles="@(CopyFiles)" DestinationFolder="$(SolutionDir)release/SPT_Runtime/user/mods/$(SolutionName)\%(RecursiveDir)"/>
    </Target>

</Project>